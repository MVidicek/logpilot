# LogPilot — Environment Variables
# Copy this to .env and adjust values for your environment.

# Server
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=logpilot
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logpilot
POSTGRES_USER=logpilot
POSTGRES_PASSWORD=logpilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Syslog
SYSLOG_ENABLED=true
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514

# Auth (REQUIRED in production — generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# Retention
RETENTION_DAYS=30

# Alerting
ALERT_CHECK_INTERVAL=60

# Ingestion
INGESTION_BATCH_SIZE=500
INGESTION_FLUSH_INTERVAL_MS=2000
